__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Per-tenant deployment config and secrets are generated lazily by setup.sh.
tenants/

# Legacy locations remain ignored so an older checkout can be imported safely.
container/.env
container/compose.ports.yaml

# Credentials arrive here by docker cp and must never be committed.
container/home/*
!container/home/README.md
shots/

# The console's default audit log — operator actions and conversation history,
# not source. See clients/web/server.py.
clients/web/console-audit.jsonl
