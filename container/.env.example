POD=acme
TENANT=hq
AGENTS=alice,bob,carol

# The api door is OPT-IN. Off by default: agents reach each other over the bus
# without it, and it is the widest surface a tenant has.
# API_ENABLED=1

# Host-side published port. The door ALWAYS binds 8080 inside the container, so
# this only chooses which host port maps onto it — set it to run a second tenant
# beside the first. Ignored while API_ENABLED is 0.
API_PORT=8080

# Required only when the door is enabled.
# API_TOKEN=<set me>

# Published beyond loopback without TLS, the bearer token crosses the network in
# clear text and the tenant refuses to start. Set API_TLS_CERT and API_TLS_KEY,
# or keep it on loopback and reach it over an SSH forward.
# API_HOST=127.0.0.1
