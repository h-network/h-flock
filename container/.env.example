POD=acme
TENANT=hq
ROSTER_SEED=alice:tmux,bob:tmux,carol:tmux

# Opt in only when external clients need the API.
# API_SERVICE_ENABLED=1

# Host-side port; the container listen port remains 8080.
API_PUBLISH_PORT=8080

# Shared by the API and terminal services.
# TENANT_ACCESS_TOKEN=<set me>

# Non-loopback publication requires TLS unless explicitly allowed as insecure.
# API_PUBLISH_ADDRESS=127.0.0.1

# Host-side terminal publication; the container listen port remains 8081.
# TERMINAL_PUBLISH_ADDRESS=127.0.0.1
# TERMINAL_PUBLISH_PORT=8081
