POD=acme
TENANT=hq
ROSTER_SEED=alice:tmux,bob:tmux,carol:tmux

# The API service is opt-in. Off by default: participants reach each other over the bus
# without it, and it is the widest surface a tenant has.
# API_SERVICE_ENABLED=1

# Host-side published port. The service always listens on 8080 inside the container,
# so this only chooses which host port maps onto it — set it to run a second tenant
# beside the first. Ignored while API_SERVICE_ENABLED is 0.
API_PUBLISH_PORT=8080

# Shared by the API and terminal services; required when either is published.
# TENANT_ACCESS_TOKEN=<set me>

# Published beyond loopback without TLS, the bearer token crosses the network in
# clear text and the tenant refuses to start. Set API_TLS_CERT and API_TLS_KEY,
# or keep it on loopback and reach it over an SSH forward.
# API_PUBLISH_ADDRESS=127.0.0.1

# The terminal service listens on 8081 inside the container. Define these only
# when publishing it through the generated compose override.
# TERMINAL_PUBLISH_ADDRESS=127.0.0.1
# TERMINAL_PUBLISH_PORT=8081
